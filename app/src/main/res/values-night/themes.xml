<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode window theme: without it the window behind the first Compose frame
         is the light theme's white, which flashed on a dark-mode cold start. -->
    <style name="Theme.MyPersonalCrossword" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
