<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+ (API 31+). Older versions
   read backup_rules.xml; keep the two files in step.

   Only the game's own SharedPreferences file (profiles, saves, stats,
   settings) is copied. Everything else, including Firebase Auth and
   Installations state, stays on the device: an anonymous sign-in must never
   be restored onto, or cloned to, another phone.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="CrosswordSaves.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CrosswordSaves.xml" />
    </device-transfer>
</data-extraction-rules>
