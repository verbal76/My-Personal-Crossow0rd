<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 6 to 11 (API 23-30). Android 12+ reads
   data_extraction_rules.xml instead; keep the two files in step.

   Only the game's own SharedPreferences file (profiles, saves, stats,
   settings) is backed up. Everything else, including Firebase Auth and
   Installations state, stays on the device: an anonymous sign-in must never
   be restored onto, or cloned to, another phone.
-->
<full-backup-content>
    <include domain="sharedpref" path="CrosswordSaves.xml" />
</full-backup-content>
